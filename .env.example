# ─────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────
# En dev : SQLite (aucune installation requise)
# En prod : PostgreSQL — changer `provider` dans prisma/schema.prisma à "postgresql"
#           et fournir une URL postgres://...
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────
# auto | ollama | anthropic | openai | mistral | stub
# auto = Ollama on-premise si dispo, sinon Anthropic (clé), sinon cloud, sinon stub
# stub = réponses déterministes, fonctionne SANS clé API
# (éditable aussi depuis Paramètres ; la valeur en base prime sur l'env)
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ─────────────────────────────────────────────
# RAG / Embeddings
# ─────────────────────────────────────────────
# auto | ollama | openai | hash (hash = repli local sans modèle)
EMBEDDING_PROVIDER=auto
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# Auth (sessions signées — sans dépendance externe)
# ─────────────────────────────────────────────
# Secret de signature des cookies de session. OBLIGATOIRE en production.
# Générer : openssl rand -hex 32
AUTH_SECRET=
# 1er administrateur : créé au tout premier login avec ces identifiants
# (utile en production sur base vierge). À changer impérativement.
ADMIN_EMAIL=chef.projet@cd93.fr
ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AI Pré-Cadrage"

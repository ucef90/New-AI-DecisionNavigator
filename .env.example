# ─────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────
# En dev : SQLite (aucune installation requise)
# En prod : PostgreSQL — changer `provider` dans prisma/schema.prisma à "postgresql"
#           et fournir une URL postgres://...
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────
# stub | openai | mistral | ollama
# stub = réponses déterministes, fonctionne SANS clé API
LLM_PROVIDER=stub

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ─────────────────────────────────────────────
# Auth (NextAuth / Auth.js)
# ─────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AI Pré-Cadrage"

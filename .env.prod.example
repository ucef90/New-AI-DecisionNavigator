# ── .env de PRODUCTION (à copier en .env sur le VPS) ──────────
# Copier : cp .env.prod.example .env  puis remplir les valeurs.

# Note : le HTTPS (ACME_EMAIL) est désormais géré par le reverse proxy partagé
# (voir deploy/proxy/.env), plus par cette app. Rien à mettre ici pour Caddy.

# Secret de signature des sessions — OBLIGATOIRE. Générer :
#   openssl rand -hex 32
AUTH_SECRET=

# Premier administrateur (créé au 1er login). À PERSONNALISER.
ADMIN_EMAIL=admin@ia-decision.com
ADMIN_PASSWORD=change-moi-vite

# ── Moteur IA ─────────────────────────────────────────────────
# Profil A (recommandé, fluide) : LLM cloud Anthropic + embeddings locaux.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Profil B (100% souverain, plus lent) : tout en local Ollama.
#   LLM_PROVIDER=ollama
#   (et pull du modèle de chat — voir le guide de déploiement)
OLLAMA_MODEL=qwen2.5:3b

# Embeddings (RAG) : local par défaut.
EMBEDDING_PROVIDER=auto
OLLAMA_EMBED_MODEL=nomic-embed-text

NEXT_PUBLIC_APP_NAME=AI Pré-Cadrage

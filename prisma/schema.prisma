// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  role         UserRole   @default(USER)
  passwordHash String? // scrypt — null tant que non défini (amorçage au 1er login)
  createdAt    DateTime   @default(now())
  projects     Project[]
  auditLogs    AuditLog[]
}

enum UserRole {
  ADMIN
  USER
}

model Project {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  name             String
  direction        String?
  description      String?
  contextBrief     String? // synthèse du contexte produite à partir des documents
  status           ProjectStatus     @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  answers          Answer[]
  decision         Decision?
  regulatoryAlerts RegulatoryAlert[]
  vendorAnalyses   VendorAnalysis[]
  reports          Report[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  solutionProposal SolutionProposal?
  frameworkAssessment FrameworkAssessment?
}

model Attachment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String?
  size      Int
  text      String? // texte extrait (référence / analyse)
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  DONE
}

model Answer {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionKey      String // Q1..Q10, QR1..QR3
  value            Json // réponse brute (string, array, etc.)
  llmReformulation String? // uniquement pour Q1
  answeredAt       DateTime @default(now())

  @@unique([projectId, questionKey])
}

model Decision {
  id                 String          @id @default(uuid())
  projectId          String          @unique
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verdict            Verdict
  techRecommendation TechType?
  justification      String
  score              Json // { axe1: 2, axe2: 3, axe3: 1, axe4: 2, axe5: 2, axe6: 2, total: 12 }
  rulesTriggered     Json // ["R1", "R6"]
  regulatoryLevel    RegulatoryLevel
  generatedAt        DateTime        @default(now())
}

enum Verdict {
  GO
  POC
  STUDY
  AUTOMATION
  NOGO
}

enum TechType {
  RPA
  ML
  LLM
  RAG
  OCR
  AGENT
}

enum RegulatoryLevel {
  HIGH
  MEDIUM
  LOW
  MINIMAL
}

model RegulatoryAlert {
  id         String              @id @default(uuid())
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level      AlertLevel
  framework  RegulatoryFramework
  article    String? // ex: "Art. 22"
  obligation String // description de l'obligation
  action     String // action concrète à mener
  deadline   String? // ex: "Avant lancement", "2 déc. 2027"
}

enum AlertLevel {
  HIGH
  MEDIUM
  LOW
}

enum RegulatoryFramework {
  RGPD
  AI_ACT
  ISO_42001
  CNIL
  CSE
  OTHER
}

model VendorAnalysis {
  id               String                @id @default(uuid())
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentName     String?
  documentContent  String? // texte extrait du PDF
  solutionSummary  String? // ce que fait la solution + architecture
  relevance        String? // pertinence vs besoin
  maturityScore    Int? // fiabilité / maturité sur 20
  maturityJustification String?
  fitScore         Int? // 1-5
  fitJustification String?
  redFlags         Json // [{ severity, claim, concern }]
  hiddenDependencies Json? // ["..."]
  questions        Json // [{ question, why }]
  recommendations  String?
  recommendation   VendorRecommendation?
  userScore        Int? // note manuelle attribuée par l'utilisateur (0-100)
  createdAt        DateTime              @default(now())
}

enum VendorRecommendation {
  PROCEED
  CAUTION
  AVOID
}

model Report {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format      ReportFormat
  content     String // markdown
  filePath    String? // chemin PDF généré
  generatedAt DateTime     @default(now())
}

enum ReportFormat {
  PDF
  MARKDOWN
}

/// Proposition de solution technique détaillée, générée par le LLM à partir du
/// cadrage du projet (une par projet, remplacée à chaque régénération).
/// `content` = objet structuré, voir SolutionProposalData dans lib/prompts/solution.ts.
model SolutionProposal {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content     Json
  llmProvider String?
  llmModel    String?
  generatedAt DateTime @default(now())
}

/// V2 — Cadrage basé sur le Framework 6 socles (une évaluation par projet).
/// Chaque étape du pipeline persiste son artefact (JSON). Voir lib/v2/pipeline.ts
/// et lib/prompts/framework.ts pour la forme des objets.
model FrameworkAssessment {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  docAnalysis Json? // DocAnalysis
  questions   Json? // GeneratedQuestion[]
  answers     Json? // [{ id, socle, question, answer }]
  scoring     Json? // ScoringResult
  report      String? // rapport markdown

  // Champs dénormalisés pour l'affichage / les listes
  decision     String? // GO_PRODUCTION | GO_POC | CONDITIONNEL | NO_GO
  scoreGlobal  Int? // 0..55
  pourcentage  Int? // 0..100
  // Étape atteinte : CREATED | ANALYZED | QUESTIONS | SCORED | REPORTED
  status       String  @default("CREATED")
  llmProvider  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

/// Réglages applicatifs persistés (ligne unique "singleton"), dont le choix LLM.
model AppSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt @default(now())
}

/// Base de connaissances (RAG) — un document = une source indexée.
model KnowledgeDocument {
  id          String           @id @default(uuid())
  title       String
  source      KnowledgeSource  @default(MANUAL)
  sourceRef   String? // id d'origine (attachmentId, vendorAnalysisId, projectId, slug…)
  projectId   String? // null = connaissance GLOBALE (réutilisable par tous les projets)
  uri         String?
  tags        Json? // ["RGPD", "IA Act"]
  contentHash String // dédup / détection de changement
  chunkCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([source])
  @@index([projectId])
  @@index([source, sourceRef])
}

/// Fragment de document + son vecteur d'embedding (stocké en JSON).
model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  idx        Int
  content    String
  embedding  Json // number[] sérialisé
  model      String // tag du modèle d'embedding (ex: "ollama:nomic-embed-text")
  dim        Int
  source     KnowledgeSource // dénormalisé pour filtrer vite à la récupération
  projectId  String?
  createdAt  DateTime          @default(now())

  @@index([model])
  @@index([projectId])
}

enum KnowledgeSource {
  REFERENCE // corpus de référence (réglementaire, méthodo)
  ATTACHMENT // document joint à un projet
  VENDOR // analyse de réponse fournisseur
  DECISION // décision / verdict d'un projet
  REPORT // rapport généré
  ANSWER // réponses au questionnaire
  MANUAL // saisi à la main
}

model AuditLog {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // ex: "ANSWER_SAVED", "REPORT_GENERATED", "VENDOR_UPLOADED"
  detail    Json?
  createdAt DateTime @default(now())
}
